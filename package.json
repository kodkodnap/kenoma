{
  "name": "estatica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ESTÁTICA (web, Three.js) — deprecada; el desarrollo activo vive en godot/ (Kenoma). Juego de horror y señales.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "skills:check": "node scripts/skills-check.mjs",
    "skills:sync": "node scripts/skills-sync.mjs",
    "verify": "npm run skills:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
